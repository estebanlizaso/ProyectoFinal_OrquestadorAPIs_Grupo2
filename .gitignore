# Archivos generados al compilar proyectos .NET (en cualquier carpeta)
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Pp]ublish/

# .NET and NuGet generated files
packages/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Node.js and frontend build output
node_modules/
dist/
dist-ssr/
coverage/
.vite/

# Local environment and secrets
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.key

# IDE and editor files
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Test results and coverage reports
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*/
coverage*.json
coverage*.xml
coverage*.info

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
