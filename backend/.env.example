ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=orquestador;Username=postgres;Password=YOUR_PASSWORD
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Drive (cuenta compartida del grupo). Sin JSON; valores directos en el .env.
# Mail (solo login manual): orquestadordeapisbdt@gmail.com
DRIVE_ENABLED=boolean
DRIVE_ID= string
CLIENT_DRIVE=string
CLIENT_SECRET_DRIVE=string
REFRESH_TOKEN_DRIVE=string
# Proveedor de IA activo: Gemini (por defecto) o Bdt. Se puede fijar con AI__Provider.
# AI__Provider=Bdt
BDT_API_URL=https://YOUR_BDT_HOST/v1
BDT_API_KEY=YOUR_BDT_API_KEY
# Opcional: qwen-rapido (por defecto) o qwen-maximo
# BDT_MODEL=qwen-rapido
